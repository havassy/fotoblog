   <dc:subject>
    <rdf:Bag>
     <rdf:li>Montenegró</rdf:li>
     <rdf:li>eső</rdf:li>
     <rdf:li>hangulat</rdf:li>
     <rdf:li>hely</rdf:li>
     <rdf:li>időjárás</rdf:li>
     <rdf:li>növény</rdf:li>
     <rdf:li>ország</rdf:li>
     <rdf:li>téma</rdf:li>
     <rdf:li>virág</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Ezen a napon is reggel a felhőké volt a főszerep, folytatódott a különleges időjárási látványok sora. Délután a Međed és a Savin Kuk közötti völgyben túráztunk. A képet nagynehezen választottam ki erre a napra - talán az egész út jelképe is lehetne a sok felhővel és a sok virággal. Éjszakára a kedvenc Njegovuđa melletti táborhelyen ütöttünk tanyát.</rdf:li>
    </rdf:Alt>
   </dc:description>
