   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Komovi, háttérben az Albán-Alpok</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Havassy Andras</rdf:li>
    </rdf:Alt>
