   <dc:subject>
    <rdf:Bag>
     <rdf:li>Komovi</rdf:li>
     <rdf:li>Montenegró</rdf:li>
     <rdf:li>hegység</rdf:li>
     <rdf:li>hely</rdf:li>
     <rdf:li>ország</rdf:li>
     <rdf:li>táj</rdf:li>
     <rdf:li>tájnév</rdf:li>
     <rdf:li>téma</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Az idei út nagy felfedezése számomra a Komovi! Nagyon szép ez a hely! Szállástípust váltottunk és az eddigi vadkemping helyett egy Etno Selo házában szálltunk meg. Első nap egy (kimerítő) bemelegítő túrát tettünk a másnapi még nagyobb túra előtt.</rdf:li>
    </rdf:Alt>
   </dc:description>
