   <dc:subject>
    <rdf:Bag>
     <rdf:li>Montenegró</rdf:li>
     <rdf:li>hely</rdf:li>
     <rdf:li>ország</rdf:li>
     <rdf:li>szobor</rdf:li>
     <rdf:li>téma</rdf:li>
     <rdf:li>épített</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Elindultunk hazafelé. Cetinjén, a régi fővároson át mentünk a Lovćen-hegyre, ahol megnéztük a Njegoš-mauzóleumot. Hosszasan csodáltunk és fotóztunk egy dalmát hegyesfejű gyíkot. Bosznián keresztül mentünk Horvátországba, ahol kerestünk egy vadkemping helyet. Nem volt könnyű.</rdf:li>
    </rdf:Alt>
   </dc:description>
