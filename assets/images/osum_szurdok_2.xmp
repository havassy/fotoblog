 <rdf:Description rdf:about=''
  xmlns:dc='http://purl.org/dc/elements/1.1/'>
  <dc:description>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>Az előző nap rengeteg különböző élményével ellentétben ez a nap egy dolgoról szólt: végigjártuk az Osum szurdokát, a nap végén pedig elfogasztottuk jól megérdemelt vacsoránkat a çorovodai étteremben. A későbbi évek tapasztalata alapján jó időpontban jöttünk. A szurdokban volt víz, de nem voltak turisták. Azóta ez megfordult.</rdf:li>
   </rdf:Alt>
  </dc:description>
  <dc:format>image/jpeg</dc:format>
  <dc:rights>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>Havassy András</rdf:li>
   </rdf:Alt>
  </dc:rights>
  <dc:subject>
   <rdf:Bag>
    <rdf:li>Albánia</rdf:li>
    <rdf:li>Osum</rdf:li>
    <rdf:li>folyó</rdf:li>
    <rdf:li>hely</rdf:li>
    <rdf:li>ország</rdf:li>
    <rdf:li>táj</rdf:li>
    <rdf:li>tájnév</rdf:li>
    <rdf:li>téma</rdf:li>
    <rdf:li>völgy</rdf:li>
   </rdf:Bag>
  </dc:subject>
  <dc:title>
   <rdf:Alt>
    <rdf:li xml:lang='x-default'>Osum-szurdok</rdf:li>
   </rdf:Alt>
  </dc:title>
 </rdf:Description>

