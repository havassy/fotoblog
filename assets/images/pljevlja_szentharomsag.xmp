   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Pljevljai Szentháromság-kolostor</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Havassy Andras</rdf:li>
