   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Naplemente a Tara-kanyon felett</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Havassy Andras</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Durmitor</rdf:li>
     <rdf:li>Montenegró</rdf:li>
     <rdf:li>fa</rdf:li>
     <rdf:li>hangulat</rdf:li>
     <rdf:li>hely</rdf:li>
     <rdf:li>napnyugta-kelte</rdf:li>
     <rdf:li>napszak</rdf:li>
     <rdf:li>növény</rdf:li>
     <rdf:li>ország</rdf:li>
     <rdf:li>tájnév</rdf:li>
     <rdf:li>téma</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A második nap beléptünk Montenegróba. A határ utáni első benzinkútnál volt diákjaimmal futottunk össze. Megnéztük a felújítás alatt lévő Tara hidat, majd Zsabljakon át mentünk a Durmitorba. Kerestünk egy olyan vadkemping helyet, ami nincs nagyon messze a másnapi túra helyszínétől. A kép a Durmitor panoráma út (Durmitor Ring) menti kilátóhelyen készült.</rdf:li>
    </rdf:Alt>
   </dc:description>
