   <dc:subject>
    <rdf:Bag>
     <rdf:li>Bosznia-Hercegovina</rdf:li>
     <rdf:li>Višegrad</rdf:li>
     <rdf:li>hely</rdf:li>
     <rdf:li>híd</rdf:li>
     <rdf:li>ország</rdf:li>
     <rdf:li>település</rdf:li>
     <rdf:li>téma</rdf:li>
     <rdf:li>épített</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Délelőtt túráztunk a Tara Nemzeti Parkban, kilátóhelyeket kerestünk a Drinára. Délután Višegradon keresztül, az öreg híd (Szokoli Mehmed pasa hídja) érintésével mentünk Montenegróba. Humnál volt egy zűrös határátkelésünk, akkor még a mostaninál (2026) is rosszabb volt az út állapota. Kezdett ránk sötétedni, ezért a Trsa felé vezető út mentén táboroztunk le.</rdf:li>
    </rdf:Alt>
   </dc:description>
