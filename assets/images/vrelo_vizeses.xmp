   <dc:subject>
    <rdf:Bag>
     <rdf:li>Bosznia-Hercegovina</rdf:li>
     <rdf:li>Drina</rdf:li>
     <rdf:li>Szerbia</rdf:li>
     <rdf:li>hely</rdf:li>
     <rdf:li>ország</rdf:li>
     <rdf:li>táj</rdf:li>
     <rdf:li>tájnév</rdf:li>
     <rdf:li>téma</rdf:li>
     <rdf:li>vízesés</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Ezt a vízesést mindig felülről, sőt, szinte rajta ülve láttuk, mert fölé építették az étterem teraszát. Egy kanyarral átjöttünk Boszniába, hogy megnézzük szemből is. A határőrök kicsit furcsállották, hogy csak úgy megyünk oda-vissza és nem csempészünk semmit. Délután a Rača kolostorban voltunk, majd kirándultunk a Lađevac-forrás környékén. Este gyönyörű naplementénk volt a Drina mellett.</rdf:li>
    </rdf:Alt>
   </dc:description>
